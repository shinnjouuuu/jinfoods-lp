{
  "name": "jinfoods-lp",
  "version": "1.0.0",
  "private": true,
  "description": "株式会社JINfoods LP（大分県／給食委託・厨房業務）",
  "scripts": {
    "dev": "sass --watch sass/style.scss:css/style.css --style=expanded --no-source-map",
    "build": "sass sass/style.scss:css/style.css --style=compressed --no-source-map",
    "build:dev": "sass sass/style.scss:css/style.css --style=expanded --no-source-map"
  },
  "devDependencies": {
    "sass": "^1.102.0"
  }
}
